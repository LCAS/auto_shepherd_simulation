FROM unityci/editor:2022.3.18f1-ubuntu-0.19.0

# Set the working directory
WORKDIR /app

# Copy the Unity project into the container
COPY . /app/

# Debug: List Unity Editor location
RUN ls -la /opt/Unity/Editor/

# Run the Unity tests with proper path
CMD ["/opt/Unity/Editor/Unity", "-batchmode", "-nographics", "-executeMethod", "UnityEditor.TestTools.TestRunner.Api.TestRunnerApi.ExecuteTests", "-projectPath", "/app"] 