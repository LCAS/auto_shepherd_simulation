FROM ros:humble

# Install necessary dependencies
RUN apt-get update && apt-get install -y \
    python3-pip \
    ros-humble-geometry-msgs \
    ros-humble-std-msgs \
    && rm -rf /var/lib/apt/lists/*

# Set the working directory
WORKDIR /app

# Copy the ROS interface script and test script into the container
COPY src/ros_interface.py /app/ros_interface.py
COPY tests/test_ros_interface.py /app/tests/test_ros_interface.py

ENV PYTHONPATH=/app:/app

RUN echo "source /opt/ros/humble/setup.bash" >> ~/.bashrc

# Run the ROS tests
CMD ["python3", "tests/test_ros_interface.py"]
